# Copy to .env (gitignored) and fill in. Leave USE_FAKE=true to develop against
# the in-memory FakeServiceNow (no live instance / no creds needed).
USE_FAKE=true
SN_INSTANCE_URL=https://nnash.service-now.com
SN_SCOPE=x_atlas_sn                 # real scope of the installed Fluent app (tables are x_atlas_sn_<table>)

# --- Live auth ---
# Default is basic: nnash (Zurich) walls the inbound-OAuth endpoints the token
# flow needs, so the app authenticates as a local non-MFA user, same as the SDK
# (decision D11). Use the atlas.sdk credentials.
SN_AUTH_TYPE=basic                  # basic | oauth
SN_USERNAME=atlas.sdk
SN_PASSWORD=                        # do NOT commit; keep in .env / Keychain only

# --- Legacy OAuth password grant (only for non-walled instances) ---
SN_OAUTH_CLIENT_ID=
SN_OAUTH_CLIENT_SECRET=
SN_OAUTH_USERNAME=
SN_OAUTH_PASSWORD=
