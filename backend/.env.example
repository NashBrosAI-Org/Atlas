# Copy to .env (gitignored) on the WORK Mac and fill in. Leave USE_FAKE=true on the personal Mac.
USE_FAKE=true
SN_INSTANCE_URL=https://nnash.service-now.com
SN_SCOPE=x_atlas_sn                 # real scope of the installed Fluent app (tables are x_atlas_sn_<table>)
SN_OAUTH_CLIENT_ID=
SN_OAUTH_CLIENT_SECRET=              # do NOT commit; use Keychain in prod (see auth.py)
SN_OAUTH_USERNAME=
SN_OAUTH_PASSWORD=
# NOTE (Task 15): nnash (Zurich) walls the legacy inbound-OAuth endpoints the
# token flow in auth.py expects. The SDK had to use basic auth via a local
# non-MFA user (atlas.sdk). The live backend connection will likely need the
# same basic-auth path rather than OAuth password grant — revisit auth.py then.
